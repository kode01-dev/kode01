    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.7.0",
    "resend": "6.1.3",
    "schema-dts": "^1.1.5",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "vanilla-cookieconsent": "^3.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
