{
  "name": "kode01-marketplace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "test": "node scripts/run-node-tests.mjs",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "check:sharp": "node -e \"require('sharp')\"",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "check:supabase-migration": "node scripts/supabase-direct-migration-check.mjs",
    "check:migrations": "node scripts/check-migration-dates.mjs",
    "audit:growth": "node scripts/audit-growth-readiness.mjs",
    "audit:growth:db": "node scripts/audit-growth-readiness.mjs --live",
    "perf:load": "node scripts/perf/load-test.mjs",
    "perf:gate": "node scripts/perf/check-perf-gate.mjs",
    "perf:admin-users-auth": "node --import tsx scripts/perf/admin-users-auth-hydration.bench.ts",
    "perf:ads-campaign-stats": "node --import tsx scripts/perf/ads-campaign-stats-placements.bench.ts",
    "perf:auth-password-history": "node --import tsx scripts/perf/auth-password-history-validation.bench.ts",
    "perf:cart-checkout-sessions": "node --import tsx scripts/perf/cart-checkout-stripe-session-creation.bench.ts",
    "images:backfill:dry-run": "node scripts/backfill-core-images.mjs --dry-run",
    "images:backfill:apply": "node scripts/backfill-core-images.mjs --apply",
    "ci:critical": "pnpm run scan:secrets && pnpm run lint && pnpm run typecheck && pnpm run check:sharp && pnpm run check:migrations && pnpm run build",
    "agent:runtime:modal:serve": "py -3.12 -m modal serve services/modal-agent-runtime/runtime.py::app",
    "agent:runtime:modal:deploy": "py -3.12 -m modal deploy services/modal-agent-runtime/runtime.py::app"
  },
  "dependencies": {
